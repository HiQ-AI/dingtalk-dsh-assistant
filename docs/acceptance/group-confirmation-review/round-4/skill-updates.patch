+"""只读预检或记录一次显式验证命令；不安装依赖或自动连接业务服务。"""
+
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+def timestamp():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def git(cwd, *args):
+    # 禁用可选索引刷新，保证 --check 连 Git 索引的时间戳也不写。
+    result = subprocess.run(["git", "--no-optional-locks", "-C", str(cwd), *args], capture_output=True)
+    if result.returncode:
+        raise ValueError("cannot read Git candidate; use the actual repository checkout")
+    return result.stdout
+
+
+def package_tools(cwd):
+    """声明优先；无声明时只在锁文件唯一指向一个工具时选择。"""
+    package = cwd / "package.json"
+    if not package.is_file():
+        return {"packageManager": None, "locks": []}
+    data = json.loads(package.read_text(encoding="utf-8-sig"))
+    lock_names = {"npm": ("package-lock.json", "npm-shrinkwrap.json"),
+                  "yarn": ("yarn.lock",), "pnpm": ("pnpm-lock.yaml",)}
+    locks = {manager: [name for name in names if (cwd / name).is_file()]
+             for manager, names in lock_names.items()}
+    declared = data.get("packageManager")
+    if declared:
+        if not isinstance(declared, str) or not re.fullmatch(r"(npm|yarn|pnpm)@[^\s]+", declared):
+            raise ValueError("unsupported packageManager declaration; inspect repository guidance")
+        manager = declared.split("@", 1)[0]
+        if not locks[manager]:
+            raise ValueError("declared packageManager has no matching lockfile")
+    else:
+        candidates = [manager for manager, files in locks.items() if files]
+        if len(candidates) != 1:
+            raise ValueError("packageManager is not declared and lockfiles are missing or ambiguous")
+        manager = candidates[0]
+    return {"packageManager": declared or manager, "locks": locks[manager],
+            "otherLocks": [name for key, names in locks.items() if key != manager for name in names]}
+
+
+def candidate(cwd, excluded=None):
+    """只保留身份摘要，包含未提交及未跟踪源码；不将源码正文写进证据。"""
+    root = Path(git(cwd, "rev-parse", "--show-toplevel").decode().strip()).resolve()
+    untracked = []
+    for raw in git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0"):
+        if not raw:
+            continue
+        relative = raw.decode("utf-8")
+        path = root / relative
+        if excluded and path.resolve().is_relative_to(excluded):
+            continue
+        value = str(path.readlink()).encode() if path.is_symlink() else path.read_bytes()
+        untracked.append([relative, digest(value)])
+    return {"root": str(root), "head": git(root, "rev-parse", "HEAD").decode().strip(),
+            "trackedDiffSha256": digest(git(root, "-c", "diff.autoRefreshIndex=false", "diff",
+                                            "--no-ext-diff", "--no-textconv", "--binary", "HEAD")),
+            "untrackedSha256": digest(json.dumps(untracked, ensure_ascii=False).encode()),
+            "untrackedFiles": len(untracked)}
+
+
+def write_record(path, record):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(record, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cwd", required=True, type=Path)
+    parser.add_argument("--check", action="store_true", help="零写预检，不运行命令")
+    parser.add_argument("--evidence-dir", type=Path)
+    parser.add_argument("--name")
+    parser.add_argument("command", nargs=argparse.REMAINDER)
+    args = parser.parse_args()
+    cwd = args.cwd.resolve(strict=True)
+    if not cwd.is_dir():
+        parser.error("cwd must be a directory")
+    evidence = args.evidence_dir.resolve() if args.evidence_dir else None
+    command = args.command[1:] if args.command[:1] == ["--"] else args.command
+    tools = package_tools(cwd)
+    before = candidate(cwd, evidence)
+    if evidence and Path(before["root"]).is_relative_to(evidence):
+        parser.error("evidence directory must not contain or equal the repository root")
+    if args.check:
+        if command:
+            parser.error("--check must not include a command")
+        print(json.dumps({"check": "passed", "tools": tools, "candidate": before}, ensure_ascii=False))
+        return 0
+    if not evidence or not args.name or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,79}", args.name) or not command:
+        parser.error("run requires --evidence-dir, a lowercase --name and -- command arguments")
+    evidence.mkdir(parents=True, exist_ok=True)
+    record_path = evidence / (args.name + ".json")
+    stdout_path = evidence / (args.name + ".stdout.log")
+    stderr_path = evidence / (args.name + ".stderr.log")
+    paths = [record_path, stdout_path, stderr_path]
+    if any(path.exists() for path in paths):
+        raise ValueError("evidence already exists; use a new round/name, do not overwrite")
+    record = {"command": command, "cwd": str(cwd), "tools": tools, "candidateBefore": before,
+              "startedAt": timestamp(), "state": "starting", "exitCode": None,
+              "stdout": str(stdout_path), "stderr": str(stderr_path)}
+    # 同名并发启动只能有一个记录所有者，不能覆盖已有轮次。
+    with record_path.open("x", encoding="utf-8") as initial:
+        initial.write(json.dumps(record, ensure_ascii=False, indent=2) + "\n")
+    process = None
+    try:
+        # 直接文件句柄持续接收完整原始字节，不受模型输出截断影响。
+        with stdout_path.open("xb") as stdout, stderr_path.open("xb") as stderr:
+            process = subprocess.Popen(command, cwd=cwd, stdout=stdout, stderr=stderr, shell=False)
+            record.update(state="running", pid=process.pid)
+            write_record(record_path, record)
+            record["exitCode"] = process.wait()
+        record["state"] = "completed"
+    except KeyboardInterrupt:
+        if process and process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+        record["state"] = "interrupted"
+    except OSError as error:
+        record.update(state="start-failed", errorType=type(error).__name__)
+    finally:
+        record["finishedAt"] = timestamp()
+        try:
+            record["candidateAfter"] = candidate(cwd, evidence)
+            record["candidateUnchanged"] = record["candidateAfter"] == before
+        except (OSError, ValueError):
+            record["candidateUnchanged"] = None
+        record["logs"] = {path.name: {"bytes": path.stat().st_size, "sha256": digest(path.read_bytes())}
+                          for path in (stdout_path, stderr_path) if path.is_file()}
+        record["validCommandEvidence"] = (record["state"] == "completed" and record["exitCode"] == 0
+                                          and record["candidateUnchanged"] is True)
+        write_record(record_path, record)
+    valid = record["validCommandEvidence"]
+    print(json.dumps({"record": str(record_path), "state": record["state"], "exitCode": record["exitCode"],
+                      "candidateUnchanged": record["candidateUnchanged"], "validCommandEvidence": valid}, ensure_ascii=False))
+    return 0 if valid else record["exitCode"] if isinstance(record["exitCode"], int) and 1 <= record["exitCode"] <= 255 else 1
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError) as error:
+        # 诊断只报固定原因/类型，不打印可能含秘密的进程输出或文件正文。
+        print(json.dumps({"error": str(error) if isinstance(error, ValueError) else type(error).__name__}), file=sys.stderr)
+        sys.exit(2)
