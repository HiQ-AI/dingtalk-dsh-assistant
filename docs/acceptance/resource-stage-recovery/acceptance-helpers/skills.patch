+def assert_snapshot_version(actual, expected):
+    """区分解析契约失败与真实版本不符；返回已核验版本供安全摘要记录。"""
+    actual_version = snapshot_version(actual)
+    expected_version = snapshot_version(expected)
+    if actual_version != expected_version:
+        raise AssertionError("snapshot-version.mismatch")
