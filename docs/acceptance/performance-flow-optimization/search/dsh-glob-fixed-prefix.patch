diff --git a/packages/fs/tool-fs-search/tests/integration.spec.ts b/packages/fs/tool-fs-search/tests/integration.spec.ts
index 94be0e1..480f0f8 100644
--- a/packages/fs/tool-fs-search/tests/integration.spec.ts
+++ b/packages/fs/tool-fs-search/tests/integration.spec.ts
@@ -47,0 +48,23 @@ describe('search tools over the real subprocess service + the packaged rg', () =
+  it('prunes fixed directories while preserving shallow, hidden, ignored, VCS and absent results', async () => {
+    await mkdir(join(dir, 'docs', 'nested'), { recursive: true })
+    await mkdir(join(dir, 'docs', 'node_modules', 'pkg'), { recursive: true })
+    await mkdir(join(dir, 'docs', '.git'), { recursive: true })
+    for (const file of ['a.md', '.hidden.md', 'ignored.md', 'nested/a.md', 'node_modules/pkg/a.md', '.git/config.md']) {
+      await writeFile(join(dir, 'docs', file), 'fixture')
+    }
+    await writeFile(join(dir, 'docs', '.gitignore'), 'ignored.md\nnode_modules/\n')
+    const shallow = await call('glob', { pattern: 'docs/*.md', path: dir }, agent())
+    expect(shallow.isError).toBeFalsy()
+    expect(text(shallow)).toContain('a.md')
+    expect(text(shallow)).toContain('.hidden.md')
+    expect(text(shallow)).toContain('ignored.md')
+    expect(text(shallow)).not.toContain('nested')
+    expect(text(shallow)).not.toContain('node_modules')
+    const recursive = await call('glob', { pattern: 'docs/**/*', path: dir }, agent())
+    expect(text(recursive)).toContain('node_modules')
+    expect(text(recursive)).not.toContain('config.md')
+    const absent = await call('glob', { pattern: 'missing/deep/*.md', path: dir }, agent())
+    expect(absent.isError).toBeFalsy()
+    expect(text(absent)).not.toContain('a.md')
+  })
+
diff --git a/packages/fs/tool-fs-search/tests/tools.spec.ts b/packages/fs/tool-fs-search/tests/tools.spec.ts
