--- a/packages/fs/tool-fs-search/tests/tools.spec.ts
+++ b/packages/fs/tool-fs-search/tests/tools.spec.ts
@@ -1209,0 +1210,15 @@ describe('helpers', () => {
+
+it('glob prunes only literal directory prefixes at the session root', () => {
+  const cwd = process.cwd()
+  expect(buildGlobCommand({ pattern: 'docs/acceptance/*.md', path: '.' }, cwd).slice(0, 6)).toEqual([
+    '--files', '--glob=!/*/', '--glob=/docs/', '--glob=!/docs/*/', '--glob=/docs/acceptance/', '--glob=docs/acceptance/*.md',
+  ])
+  expect(buildGlobCommand({ pattern: 'docs/*/goal.md' }, cwd).slice(0, 4)).toEqual([
+    '--files', '--glob=!/*/', '--glob=/docs/', '--glob=docs/*/goal.md',
+  ])
+  for (const pattern of ['*.md', '**/*.md', '../docs/*.md', './docs/*.md', '/docs/*.md', '{docs,src}/*.md', 'docs\\name/*.md']) {
+    expect(buildGlobCommand({ pattern }, cwd)).toEqual(buildGlobCommand({ pattern }))
+  }
+  expect(buildGlobCommand({ pattern: 'docs/*.md', path: 'elsewhere' }, cwd))
+    .toEqual(buildGlobCommand({ pattern: 'docs/*.md', path: 'elsewhere' }))
+})
