@@ -89 +90,13 @@ export function parseGlobArgs(args: { pattern: string; path?: string }): GlobInp
-export function buildGlobCommand(input: GlobInput): string[] {
+export function buildGlobCommand(input: GlobInput, workdir?: string): string[] {
+  const prune: string[] = []
+  // Override globs are relative to cwd, not an arbitrary search path.
+  if (workdir !== undefined && resolve(workdir, input.path ?? '.') === resolve(workdir)) {
+    let prefix = ''
+    for (const segment of input.pattern.split('/').slice(0, -1)) {
+      if (!segment || segment === '.' || segment === '..' || /[\\*?\[\]{}!]/.test(segment)) break
+      // Directory-only overrides retain the original file whitelist and let
+      // missing prefixes return no matches rather than a missing-root error.
+      prune.push(`--glob=!/${prefix}*/`, `--glob=/${prefix}${segment}/`)
+      prefix += `${segment}/`
+    }
+  }
