+/** A closed-turn replacement may only reproject one existing verified Owner read node. */
+export function isOwnedClosedToolReplacement(event:SessionFormatEvent,events:readonly SessionFormatEvent[],receipts:ReturnType<typeof ownedArtifactReceipts>):boolean {
+  if(!isSessionFormatJsonObject(event['surfaceOp'])||event['surfaceOp']['op']!=='replace'||event['surfaceOp']['startSeq']!==event['surfaceOp']['endSeq']||!Array.isArray(event['sourceEventSeqs'])||!isSessionFormatJsonObject(event.data)||!isSessionFormatJsonObject(event.data['message']))return false
+  const message=event.data['message'];const replaced=events[event['surfaceOp']['startSeq'] as number];if(replaced?.type!=='tool/result'||!isSessionFormatJsonObject(replaced.data)||!isSessionFormatJsonObject(replaced.data['message'])||replaced.data['message']['toolCallId']!==message['toolCallId'])return false
