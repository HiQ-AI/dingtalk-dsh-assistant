+import {SessionFormatUnsupportedMigrationError} from '@deepseek-ai/dsh-session-format'
+import type {SessionFormatJsonObject} from '@deepseek-ai/dsh-session-format'
+/** Fixed Convergent v1 diagnostics; all members describe the original recorded attempt. */
+export function assertLegacyConvergence(value: unknown): void {
+  const fail=(): never=>{throw new SessionFormatUnsupportedMigrationError('invalid owned legacy convergence record')}
+  const object=(v: unknown): SessionFormatJsonObject=>{if(!v||typeof v!=='object'||Array.isArray(v))return fail();return v as SessionFormatJsonObject}
+  const keys=(v:SessionFormatJsonObject,required:string[],optional:string[]=[]):void=>{if(required.some(k=>!Object.hasOwn(v,k))||Object.keys(v).some(k=>!required.includes(k)&&!optional.includes(k)))fail()}
+  const text=(v:unknown):void=>{if(typeof v!=='string'||!v)fail()}
+  const count=(v:unknown,min=0):void=>{if(typeof v!=='number'||!Number.isSafeInteger(v)||v<min)fail()}
+  const required=['version','jobId','trigger','chunkIndex','attemptIndex','surfaceGenerationBefore','requestTokensBefore','surfaceTokensBefore','range','selectedSurfaceTokens','outcome','willContinueJob','state']
+  const numeric=['thresholdTokens','requestTokensAfter','surfaceTokensAfter','shadowedTokens','framedSummaryTokens','summaryEstimatedInputTokens','summaryReservedOutputTokens','providerInputTokens','providerOutputTokens','remainingToThreshold','nextTokenBudget','nonShrinkingSummaryTokens','nonShrinkingShadowedTokens']
+  const data=object(value);keys(data,required,[...numeric,'capacityKey','capacity','failureKind','failureMessage'])
+  if(data['version']!==1||!['pressure','context-overflow'].includes(data['trigger'] as string)||!['started','succeeded','failed'].includes(data['outcome'] as string)||!['running','completed','failed','one-shot'].includes(data['state'] as string)||typeof data['willContinueJob']!=='boolean')fail()
+  text(data['jobId']);count(data['chunkIndex']);count(data['attemptIndex'])
+  for(const k of ['surfaceGenerationBefore','requestTokensBefore','surfaceTokensBefore','selectedSurfaceTokens'])count(data[k])
+  for(const k of numeric)if(Object.hasOwn(data,k))count(data[k])
+  const range=object(data['range']);keys(range,['start','end']);count(range['start']);count(range['end'])
+  if(Object.hasOwn(data,'capacityKey'))text(data['capacityKey'])
+  if(Object.hasOwn(data,'failureMessage')&&typeof data['failureMessage']!=='string')fail()
+  if(Object.hasOwn(data,'failureKind')&&!['input-too-large','non-shrinking','cancelled','unknown'].includes(data['failureKind'] as string))fail()
+  if(Object.hasOwn(data,'capacity')){const c=object(data['capacity']);keys(c,['capacityKey','acceptedSamples','rejectedSamples','safetyMarginTokens','firstObservedAt','updatedAt'],['largestAcceptedReplayTokens','smallestRejectedReplayTokens']);text(c['capacityKey']);for(const [k,v]of Object.entries(c))if(k!=='capacityKey')count(v)}
+}
+
+/** Remap owned local range endpoints using the enclosing edge's authoritative mapping. */
+export function remapLegacyConvergence(type: string, value: SessionFormatJsonObject | import('@deepseek-ai/dsh-session-format').SessionFormatJsonValue, reference: (value: import('@deepseek-ai/dsh-session-format').SessionFormatJsonValue | undefined) => number): import('@deepseek-ai/dsh-session-format').SessionFormatJsonValue {
+  if (!['compaction/start','compaction/summary','compaction/end'].includes(type) || !value || typeof value !== 'object' || Array.isArray(value) || !Object.hasOwn(value,'convergence')) return value
+  const data=value as SessionFormatJsonObject
+  assertLegacyConvergence(data['convergence'])
+  const convergence=data['convergence'] as SessionFormatJsonObject
+  const range=convergence['range'] as SessionFormatJsonObject
+  return {...data,convergence:{...convergence,range:{...range,start:reference(range['start']),end:reference(range['end'])}}}
+}
+/** Translate replacement-generation identity after an edge inserts owned surface replacements. */
+export function remapLegacyConvergenceGeneration(type: string, value: import('@deepseek-ai/dsh-session-format').SessionFormatJsonValue, sourceGeneration: number, targetGeneration: number): import('@deepseek-ai/dsh-session-format').SessionFormatJsonValue {
+  if (!['compaction/start','compaction/summary','compaction/end'].includes(type) || !value || typeof value !== 'object' || Array.isArray(value) || !Object.hasOwn(value,'convergence')) return value
+  const data=value as SessionFormatJsonObject;assertLegacyConvergence(data['convergence']);const convergence=data['convergence'] as SessionFormatJsonObject
+  if (convergence['surfaceGenerationBefore'] !== sourceGeneration) throw new SessionFormatUnsupportedMigrationError('legacy convergence generation does not match its source surface')
+  return {...data,convergence:{...convergence,surfaceGenerationBefore:targetGeneration}}
+}
