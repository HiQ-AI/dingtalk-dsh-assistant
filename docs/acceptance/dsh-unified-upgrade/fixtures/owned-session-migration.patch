+import { SessionFormatUnsupportedMigrationError } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatEvent, SessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+
+const owned = new Set(['dingtalk/group-coordinator-session', 'dingtalk/task-owner-session',
+  'dingtalk/execution-session', 'dingtalk/execution-session-rebind'])
+
+/** Local owned legacy vocabulary; no prefix or unknown-event admission. */
+export function assertDingtalkLegacyEvent(event: SessionFormatEvent): boolean {
+  if (!owned.has(event.type)) return false
+  const fail = (): never => { throw new SessionFormatUnsupportedMigrationError(`invalid owned legacy event ${event.type} at seq ${event.seq}`) }
+  const object = (value: unknown): SessionFormatJsonObject => {
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) return fail()
+    return value as SessionFormatJsonObject
+  }
+  const keys = (value: SessionFormatJsonObject, required: readonly string[], optional: readonly string[] = []): void => {
+    if (required.some(key => !Object.hasOwn(value, key)) || Object.keys(value).some(key => !required.includes(key) && !optional.includes(key))) fail()
+  }
+  const strings = (value: SessionFormatJsonObject, names: readonly string[]): void => {
+    if (names.some(key => typeof value[key] !== 'string' || value[key] === '')) fail()
+  }
+  const positive = (value: unknown): void => { if (!Number.isSafeInteger(value) || typeof value !== 'number' || value < 1) fail() }
+  keys(object(event), ['type', 'seq', 'time', 'data', 'ignorable'])
+  if (event.ignorable !== true || !Number.isSafeInteger(event.seq) || event.seq < 0 || !Number.isSafeInteger(event.time) || event.time < 0) fail()
+  const data = object(event.data)
+  if (event.type === 'dingtalk/group-coordinator-session') {
+    keys(data, ['version', 'conversationId', 'sessionId', 'creationLease'], ['parentSessionId'])
+    if (data['version'] !== 1) fail()
+    strings(data, ['conversationId', 'sessionId'])
+    if (Object.hasOwn(data, 'parentSessionId')) strings(data, ['parentSessionId'])
+    positive(data['creationLease'])
+  } else if (event.type === 'dingtalk/task-owner-session') {
+    keys(data, ['version', 'taskId', 'sessionId', 'ownerEpoch', 'creationLease'])
+    if (data['version'] !== 1) fail()
+    strings(data, ['taskId', 'sessionId'])
+    positive(data['ownerEpoch']); positive(data['creationLease'])
+  } else if (event.type === 'dingtalk/execution-session-rebind') {
+    keys(data, ['parentSessionId', 'sessionId', 'inputDigest', 'leaseEpoch'])
+    strings(data, ['parentSessionId', 'sessionId', 'inputDigest']); positive(data['leaseEpoch'])
+  } else {
+    keys(data, ['version', 'identity', 'creationLease'])
+    positive(data['creationLease'])
+    const identity = object(data['identity'])
+    if (data['version'] === 1) {
+      keys(identity, ['taskId', 'runId', 'nodeRunId', 'generation', 'inputDigest', 'sessionId'])
+      strings(identity, ['taskId', 'runId', 'nodeRunId', 'inputDigest', 'sessionId']); positive(identity['generation'])
+    } else if (data['version'] === 2 && identity['kind'] === 'message-unit') {
+      keys(identity, ['kind', 'runId', 'unitId', 'inputVersion', 'inputDigest', 'sessionId'])
+      strings(identity, ['runId', 'unitId', 'inputDigest', 'sessionId']); positive(identity['inputVersion'])
+    } else if (data['version'] === 2 && identity['kind'] === 'task-node') {
+      keys(identity, ['kind', 'taskId', 'runId', 'nodeRunId', 'generation', 'inputDigest', 'sessionId'], ['inputVersion'])
+      strings(identity, ['taskId', 'runId', 'nodeRunId', 'inputDigest', 'sessionId']); positive(identity['generation'])
+      if (Object.hasOwn(identity, 'inputVersion')) positive(identity['inputVersion'])
+    } else fail()
+  }
+  return true
+}
+
+/** Exact producer-owned coordinator sources; counters refer to domain logs, not Session seqs. */
+export function assertDingtalkLegacySource(source: SessionFormatJsonObject): boolean {
+  if (source['kind'] !== 'coordinator' || Object.hasOwn(source, 'form')) return false
+  const fail = (): never => { throw new SessionFormatUnsupportedMigrationError('invalid owned legacy coordinator source') }
+  const object = (v: unknown): SessionFormatJsonObject => { if (!v || typeof v !== 'object' || Array.isArray(v)) return fail(); return v as SessionFormatJsonObject }
+  const keys = (v: SessionFormatJsonObject, required: string[], optional: string[] = []): void => { if (required.some(k => !Object.hasOwn(v,k)) || Object.keys(v).some(k => !required.includes(k) && !optional.includes(k))) fail() }
+  const text = (v: unknown): void => { if (typeof v !== 'string' || !v) fail() }
+  const count = (v: unknown, min = 1): void => { if (typeof v !== 'number' || !Number.isSafeInteger(v) || v < min) fail() }
+  const names = ['executionSession','taskOwner','ownerContextBase','groupCoordinator'].filter(k => Object.hasOwn(source,k))
+  if (names.length === 0) { keys(source,['kind']); return true }
+  if (names.length !== 1) fail()
+  const name = names[0] as string
+  keys(source,['kind',name],name === 'groupCoordinator' ? ['groupCoordinatorHistory'] : [])
+  const data = object(source[name])
+  if (name === 'executionSession') {
+    keys(data,['sessionId','leaseEpoch'],['inputVersion','inputDigest']);text(data['sessionId']);count(data['leaseEpoch'])
+    if (Object.hasOwn(data,'inputVersion') !== Object.hasOwn(data,'inputDigest')) fail()
+    if (Object.hasOwn(data,'inputVersion')) {count(data['inputVersion']);text(data['inputDigest'])}
+  } else if (name === 'taskOwner') {
+    keys(data,['taskId','sessionId','leaseEpoch','turnId']);text(data['taskId']);text(data['sessionId']);text(data['turnId']);count(data['leaseEpoch'])
+  } else if (name === 'ownerContextBase') {
+    keys(data,['taskId','sessionId','digest']);text(data['taskId']);text(data['sessionId']);text(data['digest'])
+  } else {
+    keys(data,['conversationId','sessionId','sessionBound','leaseEpoch','turnId','status','consumedSequence','sources','taskEventRefs','startedAt','error','retryAt'],['taskEventWatermarks','committedAt','completedAt','recovery'])
+    for (const k of ['conversationId','sessionId','turnId','startedAt']) text(data[k])
+    if (typeof data['sessionBound'] !== 'boolean' || data['status'] !== 'running' || data['error'] !== null || data['retryAt'] !== null) fail()
+    count(data['leaseEpoch']);count(data['consumedSequence'],0)
+    if (Object.hasOwn(source,'groupCoordinatorHistory') && source['groupCoordinatorHistory'] !== true) fail()
+    for (const key of ['committedAt','completedAt']) if (Object.hasOwn(data,key)) text(data[key])
+    for (const key of ['sources','taskEventRefs']) {
+      if (!Array.isArray(data[key])) fail()
+      for (const item of data[key] as SessionFormatJsonObject[]) {const v=object(item);if(key==='sources'){keys(v,['runId','sourceVersion']);text(v['runId']);count(v['sourceVersion'])}else{keys(v,['taskId','eventSeq']);text(v['taskId']);count(v['eventSeq'],0)}}
+    }
+    if (Object.hasOwn(data,'taskEventWatermarks')) for(const value of Object.values(object(data['taskEventWatermarks']))) count(value,0)
+    if (data['recovery'] !== undefined && data['recovery'] !== null) {const recovery=object(data['recovery']);keys(recovery,['kind','inputDigest'],['delayMs']);text(recovery['kind']);text(recovery['inputDigest']);if(Object.hasOwn(recovery,'delayMs'))count(recovery['delayMs'],0)}
+  }
+  return true
+}
