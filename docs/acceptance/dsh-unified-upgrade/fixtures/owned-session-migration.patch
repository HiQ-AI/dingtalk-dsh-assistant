+  }
+  for(const [ref,list]of pages){const sorted=[...list].sort((a,b)=>a.start-b.start||b.seq-a.seq);let text='',valid=true;for(const page of sorted){const overlap=Math.max(0,Math.min(page.end,text.length)-page.start);if(page.total!==sorted[0]?.total||page.start>text.length||text.slice(page.start,page.start+overlap)!==page.text.slice(0,overlap)){valid=false;break}if(page.end>text.length)text+=page.text.slice(text.length-page.start)}if(!valid||text.length!==sorted[0]?.total)continue;let value:SessionFormatJsonValue;try{value=JSON.parse(text) as SessionFormatJsonValue}catch{continue}const digest=createHash('sha256').update(canonical(value)).digest('hex');if(!ref.endsWith('sha256-'+digest+'.json'))continue;for(const page of list)out.set(page.seq,{ref,digest,total:text.length,message:page.message})}
