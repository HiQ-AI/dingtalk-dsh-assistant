+import { SessionFormatUnsupportedMigrationError, isSessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatJsonValue, SessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+const instruction='重复或被替代的工具正文仅以引用保留；原始完整工具回执仍在审计日志，当前适用正文保留一份。此投影不是新的读取或验收证明。'
+/** Remap only the explicit audit reference emitted by task-owner artifact read projection. */
+export function remapLegacyOwnerReadProjection(type: string, value: SessionFormatJsonValue, reference: (value: SessionFormatJsonValue | undefined)=>number): SessionFormatJsonValue {
+  if(type!=='tool/result'||!isSessionFormatJsonObject(value))return value
+  const message=value['message'];if(!isSessionFormatJsonObject(message)||!Array.isArray(message['content']))return value
+  const content=message['content'];const wrapper=message['role']==='user'&&content.length===1&&isSessionFormatJsonObject(content[0])&&content[0]['type']==='tool-result'?content[0]:undefined
+  const blocks=wrapper===undefined?content:wrapper['content'];if(!Array.isArray(blocks)||blocks.length!==1||!isSessionFormatJsonObject(blocks[0])||blocks[0]['type']!=='text'||typeof blocks[0]['text']!=='string')return value
+  let parsed: unknown;try{parsed=JSON.parse(blocks[0]['text'])}catch{return value}
+  if(!isSessionFormatJsonObject(parsed)||!Object.hasOwn(parsed,'historicalArtifactRead'))return value
+  const fail=():never=>{throw new SessionFormatUnsupportedMigrationError('invalid owned artifact read projection')}
+  const record=parsed['historicalArtifactRead'];if(!isSessionFormatJsonObject(record)||Object.keys(parsed).sort().join(',')!=='historicalArtifactRead,instruction'||parsed['instruction']!==instruction||Object.keys(record).sort().join(',')!=='artifactRef,contentDigest,sourceSequenceId,totalLength'||typeof record['artifactRef']!=='string'||!record['artifactRef']||typeof record['contentDigest']!=='string'||!/^[a-f0-9]{64}$/u.test(record['contentDigest'])||typeof record['totalLength']!=='number'||!Number.isSafeInteger(record['totalLength'])||record['totalLength']<0)fail()
+  const next={...parsed,historicalArtifactRead:{...record as SessionFormatJsonObject,sourceSequenceId:reference((record as SessionFormatJsonObject)['sourceSequenceId'])}}
+  const mapped=[{...blocks[0],text:JSON.stringify(next)}]
+  return {...value,message:{...message,content:wrapper===undefined?mapped:[{...wrapper,content:mapped}]}}
+}
+
+/** Map the three exact user-message projections emitted by the task-owner producer. */
+export function remapLegacyOwnerMessage(type: string, value: SessionFormatJsonValue, reference: (value: SessionFormatJsonValue | undefined)=>number): SessionFormatJsonValue {
+  if(type!=='user/message'||!isSessionFormatJsonObject(value)||!isSessionFormatJsonObject(value['source'])||value['source']['kind']!=='coordinator'||!Array.isArray(value['content'])||value['content'].length!==1)return value
+  const block=value['content'][0];if(!isSessionFormatJsonObject(block)||block['type']!=='text'||typeof block['text']!=='string')return value
+  let parsed:unknown;try{parsed=JSON.parse(block['text'])}catch{return value}
+  if(!isSessionFormatJsonObject(parsed))return value
+  const snapshot=parsed['historicalOwnerSnapshot'];let next:SessionFormatJsonObject
+  const fail=():never=>{throw new SessionFormatUnsupportedMigrationError('invalid owned owner-message projection')}
+  if(snapshot!==undefined){if(!isSessionFormatJsonObject(snapshot))fail();const s=snapshot as SessionFormatJsonObject;const old=Object.hasOwn(s,'turnId');if(old){if(Object.keys(s).sort().join(',')!=='sequenceId,turnId'||typeof s['turnId']!=='string'||!s['turnId']||Object.keys(parsed).sort().join(',')!=='historicalOwnerSnapshot,instruction'||parsed['instruction']!=='superseded：此历史输入已由当前最后一条完整 Owner 快照替代；原文按 sequenceId 保留在会话审计日志中。')fail()}else if(Object.keys(s).join(',')!=='sequenceId'||Object.keys(parsed).sort().join(',')!=='historicalOwnerSnapshot,superseded'||parsed['superseded']!==true)fail();next={...parsed,historicalOwnerSnapshot:{...s,sequenceId:reference(s['sequenceId'])}}}
+  else {const key=Object.hasOwn(parsed,'restoredOwnerContext')?'restoredOwnerContext':Object.hasOwn(parsed,'historicalOwnerContext')?'historicalOwnerContext':undefined;if(key===undefined)return value
+    const owner=parsed[key];const expected=key==='restoredOwnerContext'?'artifact,instruction,restoredOwnerContext':'historicalOwnerContext,instruction'
+    if(!isSessionFormatJsonObject(owner)||Object.keys(parsed).sort().join(',')!==expected||Object.keys(owner).sort().join(',')!=='artifactRef,contentDigest,sourceEventSeqs'||typeof owner['artifactRef']!=='string'||!owner['artifactRef']||typeof owner['contentDigest']!=='string'||!/^[a-f0-9]{64}$/u.test(owner['contentDigest'])||!Array.isArray(owner['sourceEventSeqs']))fail()
+    const expectedInstruction=key==='restoredOwnerContext'?'Host从原生完整成功读取回执恢复的本轮适用正文；不是新的读取、用户指令或验收证明。摘要未变，不要重复读取。':'旧正文仅保留引用；本轮适用正文保留一份。'
+    if(parsed['instruction']!==expectedInstruction||key==='restoredOwnerContext'&&typeof parsed['artifact']!=='string')fail()
+    next={...parsed as SessionFormatJsonObject,[key]:{...owner as SessionFormatJsonObject,sourceEventSeqs:((owner as SessionFormatJsonObject)['sourceEventSeqs'] as SessionFormatJsonValue[]).map(reference)}}
+  }
+  return {...value,content:[{...block,text:JSON.stringify(next)}]}
+}
