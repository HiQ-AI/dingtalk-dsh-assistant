+export function ownedArtifactReceipts(artifact:SessionFormatArtifact):Map<number,{ref:string,digest:string,total:number,message:SessionFormatJsonObject}> {
+  const out=new Map<number,{ref:string,digest:string,total:number,message:SessionFormatJsonObject}>()
+  const identities=artifact.events.filter(e=>e.type==='plugin:dingtalk/task-owner-session')
