diff --git a/scripts/check-dsh-alpha2-api.mjs b/scripts/check-dsh-alpha2-api.mjs
new file mode 100644
index 0000000..4e75e93
--- /dev/null
+++ b/scripts/check-dsh-alpha2-api.mjs
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict'
+import { mkdtemp, mkdir, writeFile, symlink, readFile, rm } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import { dirname, join, resolve } from 'node:path'
+import { tmpdir } from 'node:os'
+import { fileURLToPath } from 'node:url'
+import { createInstalledHostContext } from './installed-host-context.mjs'
+import { validateRuntimeProjection } from './check-installed-runtime.mjs'
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+if (process.argv.length !== 3) throw new Error('usage: check-dsh-alpha2-api <installed-dsh-package.json>')
+const host = resolve(process.argv[2])
+assert.equal(JSON.parse(await readFile(host, 'utf8')).version, '0.2.1-alpha.2')
+const fixture = await mkdtemp(join(tmpdir(), 'codex-existing-alpha2-api-'))
+const profile = join(fixture, 'profiles', 'test')
+await mkdir(join(profile, 'node_modules'), { recursive: true })
+await writeFile(join(profile, 'package.json'), JSON.stringify({private:true,dependencies:{'dsh-codex-connect':'0.2.0-alpha.3'}}))
+await symlink(root, join(profile, 'node_modules/dsh-codex-connect'), process.platform === 'win32' ? 'junction' : 'dir')
+process.env.DSH_HOME = fixture
+process.env.DSH_TELEMETRY_MODE = 'DISABLED'
+let networkRequests = 0
+globalThis.fetch = async () => { networkRequests++; throw new Error('Network prohibited in synthetic API smoke') }
+const {ctx, importHost, importProfile} = await createInstalledHostContext(join(profile,'package.json'),host)
+try {
+  const requireHost = createRequire(host)
+  const cordisVersion = JSON.parse(await readFile(requireHost.resolve('@deepseek-ai/cordis/package.json'), 'utf8')).version
+  assert.equal(cordisVersion, '4.0.5-alpha.1')
+  for (const name of ['@deepseek-ai/dsh-llm','@deepseek-ai/dsh-llm-pi-ai','@deepseek-ai/dsh-compaction']) {
+    assert.equal(JSON.parse(await readFile(requireHost.resolve(`${name}/package.json`))).version,'0.2.1-alpha.2')
+  }
+  const [{default:Llm}, PiAi, Codex] = await Promise.all([importHost('@deepseek-ai/dsh-llm'),importHost('@deepseek-ai/dsh-llm-pi-ai'),importProfile('dsh-codex-connect')])
+  await ctx.plugin(Llm)
+  await ctx.plugin(PiAi,{})
+  const plugin = await ctx.plugin(Codex,{})
+  const listed = await ctx.llm.listModels('openai-codex')
+  const models = await Promise.all(listed.map(model=>ctx.llm.resolveModelInfo('openai-codex',model.id)))
+  const projection = validateRuntimeProjection(ctx.llm.listProviders(),models)
+  for(const model of models){
+    const call = await ctx.llm.prepareCall({provider:'openai-codex',model:model.id})
+    assert.equal(call.config.model,model.id)
+    assert.equal(call.config.provider,'openai-codex')
+  }
+  await plugin.dispose()
+  assert.equal(ctx.llm.listProviders().some(p=>p.id==='openai-codex'),false)
+  assert.equal(networkRequests,0)
+  console.log(JSON.stringify({dshVersion:'0.2.1-alpha.2',cordisVersion,scope:'existing-host-api-smoke-only',...projection,preparedModelCount:models.length,providerRegistration:true,disposalVerified:true,networkRequests,realCredentials:false,stockCliInstall:false}))
+} finally {
+  try { await ctx.fiber.dispose() } finally { await rm(fixture, { recursive: true, force: true }) }
+}
