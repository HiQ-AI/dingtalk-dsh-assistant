{
  "name": "@zzusp/dingtalk-dsh-observer",
  "version": "0.5.3",
  "description": "DingTalk task board client for DeepSeek Harness",
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/dingtalk-dsh-assistant.git",
    "directory": "packages/dingtalk-dsh-observer"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": "./index.js",
    "./client": "./web-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "react": "^18.2.0"
  }
}
