{
  "name": "@zzusp/dingtalk-dsh-assistant",
  "version": "0.5.0",
  "description": "DingTalk resident runtime and settings client for DeepSeek Harness",
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/dingtalk-dsh-assistant.git",
    "directory": "packages/dingtalk-dsh-assistant"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "files": [
    "*.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./resident": "./resident.js",
    "./client": "./web-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "react": "^18.2.0",
    "undici": "7.16.0",
    "zod": "^4.0.0"
  }
}
